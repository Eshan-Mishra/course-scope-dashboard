{
  "name": "course-scope-dashboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:setup": "pnpm install && pnpm dev",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter @course-scope/contracts build && pnpm --filter './apps/*' build",
    "start": "pnpm --parallel --filter './apps/*' start",
    "typecheck": "pnpm --filter @course-scope/contracts typecheck && pnpm --filter './apps/*' typecheck",
    "test": "pnpm --filter './apps/*' test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api migration:run",
    "db:seed": "pnpm --filter api seed"
  }
}
