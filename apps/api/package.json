{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:setup": "prisma generate && pnpm migration:run && pnpm seed",
    "dev": "pnpm --filter @course-scope/contracts build && pnpm db:setup && nest start --watch",
    "build": "pnpm --filter @course-scope/contracts build && prisma generate && nest build",
    "start": "pnpm migration:run && node --env-file=../../.env dist/database/seed.js && node --env-file=../../.env dist/main.js",
    "typecheck": "pnpm --filter @course-scope/contracts build && prisma generate && tsc --noEmit",
    "test": "pnpm --filter @course-scope/contracts build && prisma generate && jest --runInBand",
    "migration:run": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "seed": "node --env-file=../../.env -r ts-node/register src/database/seed.ts"
  },
  "dependencies": {
    "@course-scope/contracts": "workspace:*",
    "@prisma/client": "6.19.3",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.5",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "otpauth": "9.5.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.7.2",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
