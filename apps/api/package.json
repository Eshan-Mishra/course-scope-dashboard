{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @course-scope/contracts build && nest start --watch",
    "build": "pnpm --filter @course-scope/contracts build && nest build",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @course-scope/contracts build && tsc --noEmit",
    "test": "pnpm --filter @course-scope/contracts build && jest --runInBand",
    "migration:run": "pnpm --filter @course-scope/contracts build && typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "pnpm --filter @course-scope/contracts build && typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "seed": "pnpm --filter @course-scope/contracts build && ts-node src/database/seed.ts"
  },
  "dependencies": {
    "@course-scope/contracts": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "24.7.2",
    "jest": "29.7.0",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
